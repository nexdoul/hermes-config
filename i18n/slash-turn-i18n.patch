+    # Terminal markers appended to the heartbeat bubble. Kept as class attrs so a failed run can
+    # select "leave it alone" and a waiting run can name the wait, both from one place.
+    _HEARTBEAT_SUFFIX_DONE = " — 已完成"
+    _HEARTBEAT_SUFFIX_WAITING = " — 正在等待用户回复"
+    _HEARTBEAT_SUFFIX_STOPPED = " — 已中断"
+
+    @staticmethod
+    def _has_pending_clarify(session_key: Optional[str]) -> bool:
+        """True while the agent is blocked on an unanswered clarify prompt for this session.
+
+        Imported here rather than at module scope: ``tools.clarify_gateway`` transitively touches
+        the gateway's own registry modules (import cycle). Fail-open False so a broken import
+        can never mislabel a finished run."""
+        if not session_key:
+            return False
+        try:
+            from tools import clarify_gateway as clarify_gateway_mod
+            return bool(clarify_gateway_mod.has_pending(session_key))
+        except Exception as _cge:
+            logger.debug("clarify pending check failed: %s", _cge)
+            return False
