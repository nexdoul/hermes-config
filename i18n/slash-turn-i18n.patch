+        if _hb_adapter is None or turn_ctx._cleanup_progress:
+            return
+        _suffix = self._heartbeat_terminal_suffix(response, turn_ctx)
+        if not _suffix:
+            return
+        _hb_text = (turn_ctx._heartbeat_last_text or "").strip()
+        try:
+            _res = await _hb_adapter.edit_message(
+                turn_ctx.source.chat_id, _hb_msg_id, f"{_hb_text}{_suffix}",
+            )
+            if getattr(_res, "success", False):
+                turn_ctx._heartbeat_terminal[0] = _suffix.strip(" —")
