     @staticmethod
     def strip_cron_wrapper(content: str) -> str:
-        """Strip the scheduler's cron header/footer wrapper; unchanged when the shape doesn't match."""
+        """Strip the scheduler's cron header/footer wrapper; unchanged when the shape doesn't match.
+
+        The header prefix and divider are byte-stable contract (see
+        cron/scheduler_delivery.CRON_RESPONSE_PREFIX); the job-id line and the
+        manage-hint footer are LOCALIZED, so the footer is located by its shape
+        (the last blank-line-separated paragraph after the divider) instead of
+        by English words.
+        """
         if not content.startswith("Cronjob Response: "):
             return content
         divider = "\n-------------\n\n"
-        footer_prefix = '\n\nTo stop or manage this job, send me a new message (e.g. "stop reminder '
         divider_pos = content.find(divider)
-        footer_pos = content.rfind(footer_prefix)
-        if divider_pos < 0 or footer_pos < 0 or footer_pos <= divider_pos or "\n(job_id: " not in content[:divider_pos]:
+        if divider_pos < 0:
+            return content
+        # Header shape check: the job-id line sits between the title and the divider.
+        # Its wording is localized, so assert on the line structure (a title line plus
+        # exactly one non-empty job-id line before the divider) rather than on the
+        # English `(job_id: ` text.
+        header_lines = content[:divider_pos].split("\n")
+        if len(header_lines) != 2 or not header_lines[1].strip():
+            return content
+        # Footer: everything after the body's final blank line. The body itself may
+        # contain blank lines, so take the LAST one -- the footer is a single
+        # paragraph and always trails the payload.
+        tail = content[divider_pos + len(divider):]
+        split = tail.rfind("\n\n")
+        if split <= 0:
             return content
-        return content[divider_pos + len(divider):footer_pos].strip() or content
+        return tail[:split].strip() or content
 
