+    @staticmethod
+    def _build_notice_messages() -> tuple[str, str]:
+        """Return ``(shutdown_notice, restart_notice)`` in the active language.
+
+        Both notices used to be hardcoded English inline in
+        ``_notify_active_sessions_of_shutdown``. Extracted so they go through
+        ``agent.i18n`` and so tests can assert on them without driving a
+        real shutdown.
+        """
+        from agent.i18n import t
+
+        shutdown_msg = t("gateway.shutdown_notice.shutting_down")
+        restart_msg = t("gateway.shutdown_notice.restarting")
+        return shutdown_msg, restart_msg
+
+    @staticmethod
+    def _build_cron_interrupt_notice(job_name: str, restarting: bool) -> str:
+        """Return the localized notice sent when a scheduled job is cut short.
+
+        Used by ``_notify_cron_jobs_of_interrupt``. Two variants (shutdown vs
+        restart) because the advice differs: a restart implies the job will
+        still run on schedule, a shutdown does not promise that.
+        """
+        from agent.i18n import t
+
+        rerun_command = f"hermes cron run {job_name}"
+        key = "gateway.cron_interrupt.restart" if restarting else "gateway.cron_interrupt.shutdown"
+        return t(key, job_name=job_name, rerun_command=rerun_command)
