+"""Terminal marker stamped onto the live heartbeat message.
+
+The ``⏳ Working — N min`` heartbeat is edited in place on its own loop and simply stops when
+the run ends, leaving the bubble frozen at "Working" while the real final answer lands in a
+separate message. A user who never sees that answer is left with no signal at all.
+
+These tests cover the marker decision (done / waiting-on-user / stopped / leave-alone) and the
+edit itself (reuses the last wording, skips silently when editing is impossible or pointless).
+"""
+
+import asyncio
+import importlib
+import inspect as _inspect
+import sys
+import types
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.session import SessionSource
+
+
+# ---------------------------------------------------------------------------
+# Fakes
+# ---------------------------------------------------------------------------
+
+
+class StampAdapter(BasePlatformAdapter):
+    """Edits are recorded; sent ids let a test decide whether it supports editing."""
+
+    _next_mid = 900
+
+    def __init__(self, platform=None, *, edit_error: bool = False):
+        _platform = platform if platform is not None else Platform.TELEGRAM
+        super().__init__(PlatformConfig(enabled=True, token="***"), _platform)
+        self.sent = []
+        self.edits = []
+        self.edit_error = edit_error
+
+    async def connect(self, *, is_reconnect: bool = False) -> bool:
+        return True
+
+    async def disconnect(self) -> None:
+        return None
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None) -> SendResult:
+        mid = self._mint_id()
+        self.sent.append({"chat_id": chat_id, "content": content, "message_id": mid})
+        return SendResult(success=True, message_id=mid)
+
+    async def edit_message(self, chat_id, message_id, content) -> SendResult:
+        if self.edit_error:
+            raise RuntimeError("edit rejected by platform")
+        self.edits.append({"chat_id": chat_id, "message_id": str(message_id), "content": content})
+        return SendResult(success=True, message_id=message_id)
+
+    async def send_typing(self, chat_id, metadata=None) -> None:
+        return None
+
+    async def stop_typing(self, chat_id) -> None:
+        return None
+
+    async def get_chat_info(self, chat_id: str):
+        return {"id": chat_id}
+
+    def _mint_id(self) -> str:
+        StampAdapter._next_mid += 1
+        return str(StampAdapter._next_mid)
+
+
+class NoEditAdapter(StampAdapter):
+    """Adapter without an ``edit_message`` override (base is a no-op raising NotImplemented)."""
+
+    pass
+
+
+NoEditAdapter.edit_message = BasePlatformAdapter.edit_message
+
+
+def _make_runner(adapter):
+    gateway_run = importlib.import_module("gateway.run")
+    GatewayRunner = gateway_run.GatewayRunner
+    runner = object.__new__(GatewayRunner)
+    runner.adapters = {adapter.platform: adapter}
+    runner._voice_mode = {}
+    runner._prefill_messages = []
+    runner._ephemeral_system_prompt = ""
+    runner._reasoning_config = None
+    runner._provider_routing = {}
+    runner._fallback_model = None
+    runner._session_db = None
+    runner._running_agents = {}
+    runner._session_run_generation = {}
+    runner.hooks = SimpleNamespace(loaded_hooks=False)
+    runner.config = SimpleNamespace(
+        thread_sessions_per_user=False,
+        group_sessions_per_user=False,
+        stt_enabled=False,
+    )
+    return runner, gateway_run
+
+
+def _install_gateway_fakes(monkeypatch):
+    """Minimal module stubs so ``gateway.run`` imports in a bare test process."""
+    if "dotenv" not in sys.modules:
+        fake_dotenv = types.ModuleType("dotenv")
+        fake_dotenv.load_dotenv = lambda *a, **k: None
+        monkeypatch.setitem(sys.modules, "dotenv", fake_dotenv)
+    gateway_run = importlib.import_module("gateway.run")
+    monkeypatch.setattr(gateway_run, "_hermes_home", __import__("pathlib").Path("/tmp"))
+    return gateway_run
+
+
+def _turn_ctx(adapter, *, session_key="agent:main:telegram:group:-42"):
+    """A TurnContext wired the way ``_run_agent_bind_turn_wiring`` leaves it."""
+    from gateway.turn_context import TurnContext
+    ctx = TurnContext(
+        source=SessionSource(platform=adapter.platform, chat_id="-42"),
+        session_key=session_key,
+        _status_adapter=adapter,
+        _status_chat_id="-42",
+    )
+    return ctx
+
+
+# ---------------------------------------------------------------------------
+# Marker decision
+# ---------------------------------------------------------------------------
+
+
+def test_suffix_done_on_normal_completion():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    suffix = runner._heartbeat_terminal_suffix({"final_response": "done"}, ctx)
+    assert suffix == " — 已完成"
+
+
+def test_suffix_waiting_when_clarify_pending(monkeypatch):
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    # A registered, unresolved clarify entry is exactly the "blocked on the user" state.
+    from tools import clarify_gateway as cg
+    entry = cg.register("testclarifyid", ctx.session_key, "pick one", ["a", "b"])
+    try:
+        assert cg.has_pending(ctx.session_key) is True
+        assert runner._heartbeat_terminal_suffix({"final_response": "x"}, ctx) == " — 正在等待用户回复"
+    finally:
+        cg.clear_session(ctx.session_key)
+    # Registration gone → normal completion suffix again.
+    assert runner._heartbeat_terminal_suffix({"final_response": "x"}, ctx) == " — 已完成"
+
+
+def test_suffix_stopped_when_interrupted():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    assert runner._heartbeat_terminal_suffix({"interrupted": True}, ctx) == " — 已中断"
+
+
+def test_suffix_none_leaves_failed_run_alone():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    # A failed run must never read as success on the bubble.
+    assert runner._heartbeat_terminal_suffix({"failed": True}, ctx) is None
+
+
+def test_suffix_checks_failed_before_interrupted():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    # Both flags: failure wins so a broken run is never labelled "stopped" either.
+    assert runner._heartbeat_terminal_suffix({"failed": True, "interrupted": True}, ctx) is None
+
+
+def test_has_pending_clarify_false_without_session_key():
+    gateway_run = importlib.import_module("gateway.run")
+    GatewayRunner = gateway_run.GatewayRunner
+    assert GatewayRunner._has_pending_clarify(None) is False
+    assert GatewayRunner._has_pending_clarify("") is False
+
+
+# ---------------------------------------------------------------------------
+# The stamp itself
+# ---------------------------------------------------------------------------
+
+
+def test_stamp_appends_suffix_to_last_heartbeat_text():
+    asyncio.run(_run_stamp_appends_suffix_to_last_heartbeat_text())
+
+async def _run_stamp_appends_suffix_to_last_heartbeat_text():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    ctx._heartbeat_holder[0] = "5550001"
+    ctx._heartbeat_last_text = "⏳ Working — 6 min — iteration 19"
+
+    await runner._run_agent_stamp_heartbeat_terminal({"final_response": "done"}, ctx)
+
+    assert adapter.edits == [
+        {"chat_id": "-42", "message_id": "5550001", "content": "⏳ Working — 6 min — iteration 19 — 已完成"}
+    ]
+    assert ctx._heartbeat_terminal[0] == "已完成"
+
+
+def test_stamp_marks_waiting_when_clarify_pending(monkeypatch):
+    asyncio.run(_run_stamp_marks_waiting_when_clarify_pending())
+
+async def _run_stamp_marks_waiting_when_clarify_pending():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    ctx._heartbeat_holder[0] = "5550002"
+    ctx._heartbeat_last_text = "⏳ Working — 3 min"
+
+    from tools import clarify_gateway as cg
+    cg.register("waitingid", ctx.session_key, "q?", None)
+    try:
+        await runner._run_agent_stamp_heartbeat_terminal({"final_response": "x"}, ctx)
+    finally:
+        cg.clear_session(ctx.session_key)
+
+    assert adapter.edits[0]["content"] == "⏳ Working — 3 min — 正在等待用户回复"
+    assert ctx._heartbeat_terminal[0] == "正在等待用户回复"
+
+
+def test_stamp_noop_without_heartbeat_message():
+    asyncio.run(_run_stamp_noop_without_heartbeat_message())
+
+async def _run_stamp_noop_without_heartbeat_message():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    # Short turn: the heartbeat loop never fired, so there is nothing to stamp.
+    ctx._heartbeat_holder[0] = None
+
+    await runner._run_agent_stamp_heartbeat_terminal({"final_response": "done"}, ctx)
+
+    assert adapter.edits == []
+    assert ctx._heartbeat_terminal[0] == ""
+
+
+def test_stamp_skipped_when_cleanup_will_delete_the_bubble():
+    asyncio.run(_run_stamp_skipped_when_cleanup_will_delete_the_bubble())
+
+async def _run_stamp_skipped_when_cleanup_will_delete_the_bubble():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    ctx._heartbeat_holder[0] = "5550003"
+    ctx._heartbeat_last_text = "⏳ Working — 1 min"
+    ctx._cleanup_progress = True
+
+    await runner._run_agent_stamp_heartbeat_terminal({"final_response": "done"}, ctx)
+
+    # Editing a message that is about to be deleted would be wasted work.
+    assert adapter.edits == []
+
+
+def test_stamp_noop_when_run_failed():
+    asyncio.run(_run_stamp_noop_when_run_failed())
+
+async def _run_stamp_noop_when_run_failed():
+    adapter = StampAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    ctx._heartbeat_holder[0] = "5550004"
+    ctx._heartbeat_last_text = "⏳ Working — 9 min"
+
+    await runner._run_agent_stamp_heartbeat_terminal({"failed": True}, ctx)
+
+    assert adapter.edits == []
+
+
+def test_stamp_swallows_adapter_errors():
+    asyncio.run(_run_stamp_swallows_adapter_errors())
+
+async def _run_stamp_swallows_adapter_errors():
+    adapter = StampAdapter(edit_error=True)
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    ctx._heartbeat_holder[0] = "5550005"
+    ctx._heartbeat_last_text = "⏳ Working — 2 min"
+
+    # Must never raise: the final reply has already been delivered by this point.
+    await runner._run_agent_stamp_heartbeat_terminal({"final_response": "done"}, ctx)
+
+    assert ctx._heartbeat_terminal[0] == ""
+
+
+def test_stamp_noop_when_adapter_cannot_edit():
+    asyncio.run(_run_stamp_noop_when_adapter_cannot_edit())
+
+async def _run_stamp_noop_when_adapter_cannot_edit():
+    adapter = NoEditAdapter()
+    runner, _ = _make_runner(adapter)
+    ctx = _turn_ctx(adapter)
+    ctx._heartbeat_holder[0] = "5550006"
+    ctx._heartbeat_last_text = "⏳ Working — 4 min"
+
+    # BasePlatformAdapter.edit_message is a NotImplemented stub; the guard must skip it.
+    await runner._run_agent_stamp_heartbeat_terminal({"final_response": "done"}, ctx)
+
+    assert ctx._heartbeat_terminal[0] == ""
+
+
+# ---------------------------------------------------------------------------
+# Wiring: the holder is published by the heartbeat loop
+# ---------------------------------------------------------------------------
+
+
+def test_heartbeat_loop_publishes_message_id_to_context():
+    """The heartbeat loop must share its msg id with the finalisation path via turn_ctx."""
+    import pathlib, re
+    src = pathlib.Path(
+        "/home/hatch/.hermes/npm/node_modules/hermes-agent/runtime/hermes-agent/gateway/run_turn.py"
+    ).read_text()
+    # The loop assigns the holder right after learning the send succeeded.
+    assert "turn_ctx._heartbeat_holder[0] = _heartbeat_msg_id" in src
+    # And the turn body calls the stamp after the cleanup join.
+    assert "await self._run_agent_stamp_heartbeat_terminal(response, turn_ctx)" in src
+
+
+def test_turn_context_declares_heartbeat_state():
+    from gateway import turn_context
+    fields = {f.name for f in turn_context.TurnContext.__dataclass_fields__.values()}
+    assert "_heartbeat_holder" in fields
+    assert "_heartbeat_last_text" in fields
+    assert "_heartbeat_terminal" in fields
