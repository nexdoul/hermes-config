+"""Single source of truth for "who is the main session" and "what deserves a reminder".
+
+The main session is the one window the user actually watches: every other session is muted, so a
+reminder must reach it. This module answers two questions and nothing else:
+
+1. ``is_main_session`` — may THIS session receive reminders? (multi-surface: Feishu bot API, CLI…)
+2. ``classify`` — given how a turn ended, does it deserve a reminder at all?
+
+Design constraints that shaped it:
+
+* **No new blocking, no new thread.** Both answers are pure functions. The gateway calls them
+  from the one place every turn already passes through (see ``run_main_notifier``).
+* **Fail-silent.** A reminder is a nicety; a broken notifier must never break a turn. Every
+  caller wraps this in a bare ``except`` and moves on.
+* **Configuration lives in the gateway block** (``gateway.notifications``) so it survives a
+  reinstall and is editable without patching code.
+
+The "main session" is chosen by an exclusive, progressive match:
+
+1. ``gateway.notifications.main_session_override`` wins if set (an explicit session_key or
+   ``platform:chat_id``) — an escape hatch for when the automatic heuristic is wrong.
+2. Otherwise the first session that registers on the **configured main platform**
+   (``gateway.platform``) claims the role for the rest of the gateway's life.
+
+Claiming is intentional: the user who mutes every other window keeps exactly one watch target,
+and that target is whichever one they were already sitting in. Session keys are opaque strings
+built by the platform adapters (Feishu: ``feishu:<chat_id>``), so matching on the configured
+platform is what makes the multi-surface case correct instead of accidental.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+# Whether a session is the one that receives reminders. Locked for the whole gateway run: a
+# session must not silently start receiving reminders mid-flight, and two sessions must never
+# both believe they are the main one.
+_main_lock = threading.Lock()
+_main_session_key: Optional[str] = None
+_main_claimed: bool = False
+# Routing metadata for the main session, captured at claim time. ``_parse_session_key`` derives
+# platform/chat_id/chat_type from the key itself, so the notifier never has to guess them later —
+# that is what makes the injected reminder routable on every surface.
+_main_meta: Dict[str, Any] = {}
+
+
+def _reset_for_tests() -> None:
+    """Test-only: drop the claim so each test starts from a clean slate."""
+    global _main_session_key, _main_claimed
+    with _main_lock:
+        _main_session_key = None
+        _main_claimed = False
+        _main_meta.clear()
+
+
+@dataclass(frozen=True)
+class NotificationEvent:
+    """One reminder: what happened, in which session, and how it should read."""
+
+    kind: str            # "done" | "decision" | "danger"
+    session_key: str     # session that produced it (for the reminder's provenance line)
+    summary: str         # the short text the user reads, e.g. "115re 采集完成"
+    source_label: str = ""   # human-readable session name, when the session key is opaque
+    detail: str = ""     # optional second line, shown only when it adds information
+
+    def render(self) -> str:
+        """Markdown text of the reminder, ready to send to the main chat."""
+        icon = {
+            "done": "✅",
+            "decision": "🟡",
+            "danger": "⛔",
+        }.get(self.kind, "ℹ️")
+        head = {
+            "done": "已完成",
+            "decision": "需要决策",
+            "danger": "需要人工确认",
+        }.get(self.kind, self.kind)
+        where = f"（{self.source_label}）" if self.source_label else ""
+        lines = [f"{icon} **{head}**{where}", self.summary.strip()]
+        if self.detail.strip():
+            lines.append(self.detail.strip())
+        return "\n".join(lines)
+
+
+# ── main-session claim ────────────────────────────────────────────────────────────
+
+def claim_main_session(session_key: Optional[str], *, platform: Optional[str] = None,
+                       config: Optional[Dict[str, Any]] = None) -> bool:
+    """Try to register ``session_key`` as the reminder receiver. Returns True when it is/was main.
+
+    First caller for a given platform wins; later callers get False. The lock makes the claim
+    atomic, so a burst of concurrent turns cannot both win.
+    """
+    global _main_session_key, _main_claimed
+    if not session_key:
+        return False
+    with _main_lock:
+        if _main_claimed:
+            return _main_session_key == session_key
+        _main_session_key = session_key
+        _main_claimed = True
+        _main_meta.clear()
+        _main_meta.update(_derive_source_fields(session_key, platform))
+    logger.info("Main notification session claimed: %s (meta=%s)",
+                session_key[:64], _main_meta.get("chat_id"))
+    return True
+
+
+def main_session_meta() -> Dict[str, Any]:
+    """Routing metadata (platform/chat_id/chat_type) of the claimed main session."""
+    with _main_lock:
+        return dict(_main_meta)
+
+
+def _derive_source_fields(session_key: str, platform: Optional[str]) -> Dict[str, Any]:
+    """Best-effort routing fields for a session key, reusing the gateway's own parser.
+
+    ``_parse_session_key`` is the function the gateway itself uses to turn a session key back
+    into a SessionSource-derivable dict; using it here means a reminder routes exactly the way
+    any other synthetic event for that session would. Anything unparseable yields an empty dict
+    and the caller degrades to "no reminder", never to a wrong destination.
+    """
+    try:
+        from gateway.run import _parse_session_key
+        derived = _parse_session_key(session_key) or {}
+    except Exception:  # pragma: no cover - parser unavailable
+        derived = {}
+    if not derived and platform:
+        derived = {"platform": str(platform)}
+    return {
+        "platform": str(derived.get("platform") or platform or ""),
+        "chat_id": str(derived.get("chat_id") or ""),
+        "chat_type": str(derived.get("chat_type") or ""),
+        "thread_id": derived.get("thread_id"),
+        "user_id": derived.get("user_id"),
+        "profile": derived.get("profile"),
+    }
+
+
+def is_main_session(session_key: Optional[str], *, config: Optional[Dict[str, Any]] = None) -> bool:
+    """True when ``session_key`` is the one window the user is watching."""
+    if not session_key:
+        return False
+    override = ""
+    if isinstance(config, dict):
+        raw_override = (config.get("gateway") or {}).get("notifications", {})
+        if isinstance(raw_override, dict):
+            override = str(raw_override.get("main_session_override") or "").strip()
+    if override:
+        # An explicit override is authoritative: it can name a session the claim never saw
+        # (e.g. the user's usual window, named in config so it survives restarts).
+        return session_key == override or session_key.startswith(f"{override}:")
+    with _main_lock:
+        return _main_claimed and _main_session_key == session_key
+
+
+def main_session_key() -> Optional[str]:
+    """The current main session key, or None while unclaimed."""
+    with _main_lock:
+        return _main_session_key if _main_claimed else None
+
+
+# ── what deserves a reminder ──────────────────────────────────────────────────────
+
+# A turn that ends with a pending clarify is waiting on the user. That is exactly the "需要决策"
+# case: the agent asked, nobody in the muted windows is reading. Only the main session hears it.
+def classify(response: Any, *, session_key: str = "", delegated: bool = False,
+             has_pending_clarify: bool = False) -> Optional[NotificationEvent]:
+    """Decide whether this turn's ending deserves a reminder, and of which kind.
+
+    Returns None for "say nothing" — the overwhelmingly common case (a normal answer that the
+    user is already reading in the muted window).
+
+    What counts as "completed" follows the gateway's own response contract rather than a new
+    definition: a run carries ``final_response`` with actual text in it (``failed``/``interrupted``
+    are the two ways that is absent). An empty dict — which is what a blocked or aborted turn
+    looks like from here — is therefore NOT a completion, and a pending question outranks it.
+
+    Under full-trust delegation (``delegated``) the filter is deliberately narrower than the
+    user's standing instruction, because that is what "一次做完" means: only a genuine
+    **completion** or an **irreversible/dangerous** step interrupts the user. A branch choice
+    the agent resolves on its own during a 5-minute silence is not worth a message — the whole
+    point of the mode is that it does not get interrupted for that.
+    """
+    final_text = ""
+    if isinstance(response, dict):
+        final_text = str(response.get("final_response") or "").strip()
+        if response.get("failed") or response.get("interrupted"):
+            final_text = ""
+        elif not final_text:
+            # No answer text and no explicit failure: the turn did not produce a result.
+            final_text = ""
+
+    if final_text:
+        return NotificationEvent(
+            kind="done",
+            session_key=session_key,
+            summary=_first_line(str(response.get("final_summary") or response.get("summary")
+                                    or final_text))
+            or "这一轮的工作已完成。",
+        )
+
+    if has_pending_clarify:
+        if delegated:
+            return None
+        return NotificationEvent(
+            kind="decision",
+            session_key=session_key,
+            summary="这一步有多个方向，需要你定一个再继续。",
+        )
+
+    return None
+
+
+def _first_line(text: str, limit: int = 140) -> str:
+    """One compact line out of a possibly long summary, for the reminder body."""
+    if not text:
+        return ""
+    line = text.strip().splitlines()[0].strip()
+    return line[:limit]
+
+
+def render_notification(event: NotificationEvent) -> str:
+    """Convenience wrapper so callers do not need to know the render location."""
+    return event.render()
