+"""Deliver a reminder to the one session the user is watching (the "main" session).
+
+Every other window is muted, so this is the only way a piece of telemetry from a background
+session ever reaches the user. It is deliberately not a queue, a worker, or a thread: the
+gateway calls :func:`run_main_notifier` at the end of every turn, exactly where it already
+stamps the heartbeat bubble, and this module makes that one call cheap when it has nothing
+to do (which is almost always).
+
+Three invariants, all enforced in code rather than convention:
+
+1. **Never remind the session the user is reading.** If the current session IS the main
+   session the output is already there; sending a reminder would be a duplicate.
+2. **Never block a turn on delivery.** Delivery runs as its own fire-and-forget asyncio task
+   on the gateway loop and any failure is logged and dropped. The turn's response has already
+   been delivered by the time this runs — a reminder must never put that at risk.
+3. **Fail-silent, never fail-loud.** A reminder is a nicety. An unavailable adapter, an
+   unknown main session or a rendering error all degrade to "no message sent".
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from typing import Any, Optional
+
+from gateway import main_notifier as _policy
+
+logger = logging.getLogger(__name__)
+
+# Dedupe window: the same summary twice in a row across turns is noise, not a new milestone.
+# Keyed on (session, kind, summary) with a monotonically increasing counter so a quiet session
+# that later repeats the same line still fires (a new occurrence, not a stuck one).
+_seen: dict = {}
+_suppress_seconds = 60.0
+_gateway_ref: Any = None
+
+
+def bind_gateway(gateway: Any) -> None:
+    """Remember the runner so external callers (approval bypass) can reach its loop/adapters."""
+    global _gateway_ref
+    _gateway_ref = gateway
+
+
+def publish_external(event: dict) -> Optional[str]:
+    """Deliver a reminder that did NOT come from a turn ending.
+
+    Used by the approval bypass: a dangerous command pauses a running turn to wait for a human,
+    and that wait must be announced even though no turn has finished yet.
+
+    Routing deliberately goes through the gateway's own synthetic-event injector
+    (``_inject_watch_notification``) rather than a hand-rolled adapter lookup: that path is
+    what already carries cross-session completion notices, so it already solves profile
+    resolution, relay aliasing and push-capability checks. Re-implementing it here would be a
+    second, subtly different router.
+    """
+    gateway = _gateway_ref
+    if gateway is None:
+        return None
+    try:
+        if _policy.is_main_session(str(event.get("session_key") or "")):
+            return None  # already happening in the watched window
+        target_key = _policy.main_session_key()
+        if not target_key:
+            return None
+        text = _policy.NotificationEvent(
+            kind=str(event.get("kind") or "danger"),
+            session_key=str(event.get("session_key") or ""),
+            summary=str(event.get("summary") or ""),
+            detail=str(event.get("detail") or ""),
+        ).render()
+        injector = getattr(gateway, "_inject_watch_notification", None)
+        if not callable(injector):
+            return None
+        # Routing metadata comes from what the claim captured, not from the (finished) turn:
+        # ``_build_process_event_source`` needs platform + chat_type + chat_id to route, and a
+        # session key alone cannot supply chat_type.
+        meta = _policy.main_session_meta()
+        evt = {
+            "session_key": target_key,
+            "platform": meta.get("platform") or "",
+            "chat_id": meta.get("chat_id") or "",
+            "chat_type": meta.get("chat_type") or "",
+            "thread_id": meta.get("thread_id"),
+            "user_id": meta.get("user_id"),
+            "profile": meta.get("profile"),
+            "source": "main_notifier",
+        }
+        if not (evt["platform"] and evt["chat_id"]):
+            logger.debug("No routing metadata for main session %s; reminder dropped", target_key)
+            return None
+        loop = getattr(gateway, "_loop", None) or getattr(gateway, "loop", None)
+        coro = injector(text, evt)
+        if asyncio.iscoroutine(coro):
+            if loop is not None and loop.is_running():
+                asyncio.run_coroutine_threadsafe(coro, loop)
+            else:
+                coro.close()  # nobody would ever await it; dropping beats leaking
+        return text
+    except Exception:  # pragma: no cover - a reminder must never break a turn
+        logger.debug("external reminder declined to fire", exc_info=True)
+        return None
+
+
+def _dedupe_key(event: "_policy.NotificationEvent") -> str:
+    return f"{event.session_key}|{event.kind}|{event.summary[:80]}"
+
+
+def _should_dedupe(event: "_policy.NotificationEvent", now: float) -> bool:
+    key = _dedupe_key(event)
+    last = _seen.get(key)
+    _seen[key] = now
+    if last is None:
+        return False
+    return (now - last) < _suppress_seconds
+
+
+def run_main_notifier(gateway: Any, turn_ctx: Any, response: Any) -> Optional[str]:
+    """Maybe deliver a reminder for the turn that just finished. Returns the sent text or None.
+
+    Called from ``GatewayRunner`` right after the heartbeat terminal stamp. Every guard is
+    ordered cheapest-first so the common path costs two comparisons.
+    """
+    try:
+        session_key = getattr(turn_ctx, "session_key", None) or ""
+        if _policy.is_main_session(session_key):
+            return None  # the user is reading this window already
+
+        event = _policy.classify(
+            response,
+            session_key=session_key,
+            delegated=_is_delegated(turn_ctx),
+            has_pending_clarify=_has_pending_clarify(session_key),
+        )
+        if event is None:
+            return None
+
+        text = event.render()
+        target_key = _policy.main_session_key()
+        if not target_key:
+            return None
+
+        adapter = _delivery_adapter_for_main(gateway, turn_ctx, target_key)
+        if adapter is None:
+            return None
+
+        chat_id, metadata = _target_chat(gateway, turn_ctx, target_key)
+        if chat_id is None:
+            return None
+
+        now = asyncio.get_event_loop().time()
+        if _should_dedupe(event, now):
+            logger.debug("Reminder suppressed as duplicate: %s", event.summary[:60])
+            return None
+
+        _schedule_send(gateway, adapter, chat_id, text, metadata, event)
+        return text
+    except Exception:  # pragma: no cover - a reminder must never break a turn
+        logger.debug("main notifier declined to fire", exc_info=True)
+        return None
+
+
+# ── the pieces, kept small and individually testable ───────────────────────────────
+
+def _is_delegated(turn_ctx: Any) -> bool:
+    """True when this turn ran under full-trust delegation ("一次做完").
+
+    Reads the same per-turn state the approval bypass reads, so "the agent is deciding on its
+    own" has exactly one definition in the codebase.
+    """
+    try:
+        from tools import clarify_gateway as _reg
+        key = getattr(turn_ctx, "session_key", None) or ""
+        return bool(_reg.is_delegated(key))
+    except Exception:  # pragma: no cover - registry failure means "not delegated"
+        return False
+
+
+def _has_pending_clarify(session_key: Optional[str]) -> bool:
+    """True while the agent is blocked on an unanswered clarify in this session."""
+    if not session_key:
+        return False
+    try:
+        from tools import clarify_gateway as _reg
+        return bool(_reg.has_pending(session_key))
+    except Exception:  # pragma: no cover - same fail-open as the heartbeat's own check
+        return False
+
+
+def _delivery_adapter_for_main(gateway: Any, turn_ctx: Any, target_key: str):
+    """The live adapter that can send to the main session's chat."""
+    resolver = getattr(gateway, "_delivery_adapter_for", None)
+    source = getattr(turn_ctx, "source", None)
+    if callable(resolver) and source is not None:
+        try:
+            return resolver(source)
+        except Exception:  # pragma: no cover
+            return None
+    return None
+
+
+def _target_chat(gateway: Any, turn_ctx: Any, target_key: str):
+    """(chat_id, metadata) for the main session, resolved through the gateway's session table."""
+    source = getattr(turn_ctx, "source", None)
+    if source is not None and getattr(source, "chat_id", None) is not None:
+        meta = getattr(turn_ctx, "_status_thread_metadata", None)
+        return source.chat_id, meta
+    getter = getattr(gateway, "_chat_id_for_session", None)
+    if callable(getter):
+        try:
+            return getter(target_key), None
+        except Exception:  # pragma: no cover
+            return None, None
+    return None, None
+
+
+def _schedule_send(gateway: Any, adapter: Any, chat_id: Any, text: str,
+                   metadata: Any, event: "_policy.NotificationEvent") -> None:
+    """Send on the gateway loop without making the caller wait for it."""
+    loop = getattr(gateway, "_loop", None) or getattr(gateway, "loop", None)
+
+    async def _send() -> None:
+        try:
+            res = await adapter.send(chat_id, text, metadata=metadata)
+            ok = getattr(res, "success", True)
+            logger.info(
+                "Reminder %s delivered to main session: %s",
+                event.kind, event.summary[:60],
+            ) if ok else logger.warning("Reminder %s send failed: %s", event.kind, res)
+        except Exception as exc:  # pragma: no cover
+            logger.warning("Reminder %s send raised: %s", event.kind, exc)
+
+    if loop is None or not loop.is_running():
+        _run_inline(adapter, chat_id, text, metadata, event)
+        return
+    try:
+        asyncio.run_coroutine_threadsafe(_send(), loop)
+    except Exception:  # pragma: no cover
+        _run_inline(adapter, chat_id, text, metadata, event)
+
+
+def _run_inline(adapter: Any, chat_id: Any, text: str, metadata: Any,
+                event: "_policy.NotificationEvent") -> None:
+    """Last-resort synchronous send for surfaces with no reachable event loop."""
+    try:
+        res = adapter.send(chat_id, text, metadata=metadata)
+        if asyncio.iscoroutine(res):
+            res.close()
+    except Exception as exc:  # pragma: no cover
+        logger.debug("Inline reminder send failed: %s", exc)
