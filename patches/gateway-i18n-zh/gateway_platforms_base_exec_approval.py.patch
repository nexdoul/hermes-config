+def format_approval_window_localized(seconds: int, *, lang: str | None = None) -> str:
+    """The same window wording in the user's language (300 → "5 分钟").
+
+    ``tools.approval_context.format_approval_window`` stays English — it is also the
+    model-facing ``user_summary`` — so the localized phrasing is derived here by
+    re-formatting the number/unit pair through the catalog.
+    """
+    from agent.i18n import t
+    seconds = max(int(seconds or 0), 0)
+    count, unit = _window_parts(seconds)
+    unit_key = f"approval.exec_window_unit_{unit}"
+    plural_key = f"approval.exec_window_units_{unit}"
+    word = t(plural_key if count != 1 else unit_key, lang=lang)
+    return t("approval.exec_window_count", lang=lang, count=count, unit=word)
+
+
+def _window_parts(seconds: int) -> tuple[int, str]:
+    """(count, unit) for ``seconds``; mirrors ``tools.approval_context.format_approval_window``."""
+    if seconds and seconds % 3600 == 0:
+        return seconds // 3600, "hour"
+    if seconds and seconds % 60 == 0:
+        return seconds // 60, "minute"
+    return seconds, "second"
+
+
