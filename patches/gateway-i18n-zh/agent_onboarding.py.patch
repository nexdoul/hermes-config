+# Stable mapping to locale keys keeps first-touch notices shared across CLI and gateway.
+_BUSY_MODE_SUFFIX = {"queue": "queue", "steer": "steer", "redirect": "redirect"}
+
+
+def _onboarding_text(key: str, mode: str, *, gateway: bool) -> str:
+    """Use translated notice when selected; preserve the original English copy otherwise."""
+    from agent.i18n import get_language, t
+    if get_language().startswith("zh"):
+        return t(key)
+    suffix = _BUSY_MODE_SUFFIX.get(mode, "interrupt")
+    source = "onboarding" if gateway else "cli_onboarding"
+    return t(f"gateway.{source}.busy_{suffix}", lang="en") if mode != "tool_progress" else t(
+        f"gateway.{source}.tool_progress", lang="en"
+    )
 
 
