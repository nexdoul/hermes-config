+    # English wording the adapter templates above embed, mapped to its catalog key.
+    # ``_ea_localized`` swaps the WORD only — the markup an adapter wrapped around it
+    # (``⚠️ ``, ``**``, ``<b>``, ``✅`` …) is left untouched, and the user's command
+    # preview never passes through this path.
+    _EA_PHRASE_KEYS: Dict[str, str] = {
+        EA_HEADER_TEXT: "approval.exec_header",
+        EA_REASON_LABEL_TEXT: "approval.exec_reason_label",
+        "Smart DENY": "approval.exec_smart_deny_label",
+        "owner override applies to this one operation only.": "approval.exec_smart_deny_tail",
+        "Allow Once": "approval.action_once",
+        "Allow Session": "approval.action_session",
