+def _is_cjk(text: str) -> bool:
+    """True when ``text`` is written in a CJK script (zh / ja), where an ASCII ``:``
+    separator after the text reads wrong next to a full-width string."""
+    return any(
+        "\u3000" <= ch <= "\u9fff" or "\uff00" <= ch <= "\uffef" or "\u3040" <= ch <= "\u30ff"
+        for ch in str(text or ""))
