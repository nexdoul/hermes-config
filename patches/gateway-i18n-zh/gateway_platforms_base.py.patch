+        "Deny": "approval.action_deny",
+    }
+
+    @classmethod
+    def _ea_localized(cls, template: str) -> str:
+        """Render ``template`` in the active language.
+
+        Adapter class bodies compose markup around the English words above, so the
+        markup stays in the adapter and only the phrase is swapped. A catalog value
+        equal to its English source (the untranslated locales) is a no-op, and
+        missing keys fall back to English through ``t()``.
+        """
+        from agent.i18n import t
+        out = template
+        for english, key in cls._EA_PHRASE_KEYS.items():
+            if english in out:
+                out = out.replace(english, t(key))
+        # The trailing colon/punctuation an adapter put after the label stays as-is;
+        # a localized separator only when the language's label lacks its own.
+        return out
+
+    def _ea_localize_label(self) -> str:
+        """``_EA_REASON_LABEL`` in the active language, keeping the adapter's separator style.
+
+        Adapters write ``"Label: "``, ``"**Label:** "`` and ``"⚠️ Label: "`` — the
+        markup prefix and the trailing ``": "`` belong to the adapter, so only the
+        label word is swapped and the separator is normalized for CJK.
+        """
+        from agent.i18n import t
+        label = t("approval.exec_reason_label")
+        template = self._EA_REASON_LABEL
+        word = t("approval.exec_reason_label", lang="en")
+        out = template.replace(word, label) if word in template else template
+        if _is_cjk(label):
+            # A CJK label followed by an ASCII ":" reads wrong. The colon may sit
+            # under the adapter's markup ("Label:** " in Feishu markdown, "Label: "
+            # in plain text), so swap the first ASCII colon that follows the
+            # label and keep every surrounding character as the adapter wrote it.
+            idx = out.find(label)
+            if idx >= 0:
+                colon = out.find(":", idx + len(label))
+                if colon >= 0:
+                    out = out[:colon] + "：" + out[colon + 1:]
+        return out
+
+    def _ea_localize_smart_deny_line(self) -> str:
+        """``_EA_SMART_DENY_LINE`` in the active language (bold/emoji markup preserved)."""
+        from agent.i18n import t
+        line = self._EA_SMART_DENY_LINE
+        label, tail = t("approval.exec_smart_deny_label"), t("approval.exec_smart_deny_tail")
+        en_label = t("approval.exec_smart_deny_label", lang="en")
+        en_tail = t("approval.exec_smart_deny_tail", lang="en")
+        out = line.replace(en_tail, tail).replace(en_label, label)
+        if _is_cjk(label):
+            out = out.replace("Smart DENY:", label + ":") if en_label in line else out
+        return out
+
