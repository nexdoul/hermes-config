+    def _register_turn_autonomy(self, message) -> None:
+        """Full-trust delegation ("一次做完"): decide whether this turn runs without supervision.
+
+        Same decision the gateway makes in ``run_turn_runner._arm_turn_autonomy``, evaluated for
+        the CLI so both surfaces share the registry: a trigger phrase delegates this turn, and
+        ``agent.autonomy.mode`` delegates the session. Publishes the wait window where the
+        blocking prompts read it, and attaches the policy to the agent so the system prompt can
+        grow its delegation block. A supervised turn registers nothing at all.
+        """
+        from agent.autonomy_policy import resolve
+
+        agent = getattr(self, "agent", None)
+        if agent is None:
+            return
+        text = message if isinstance(message, str) else None
+        cfg: dict = {}
+        try:
+            from cli import load_cli_config
+            cfg = load_cli_config() or {}
+        except Exception:  # pragma: no cover - config problems must not kill a turn
+            cfg = {}
+        section = (cfg.get("agent") or {}) if isinstance(cfg, dict) else {}
+        raw = section.get("autonomy")
+        if not isinstance(raw, dict):
+            raw = {}
+        policy = resolve(
+            text,
+            session_mode=str(raw.get("mode") or "off"),
+            wait_seconds=raw.get("autonomy_wait_seconds", 300),
+            irreversible_ok=bool(raw.get("irreversible_ok", False)),
+        )
+        try:
+            agent._autonomy_policy = policy
+            agent._autonomy_triggered = policy.delegated
+        except Exception:  # pragma: no cover - a cached agent must not block a turn
+            pass
+        try:
+            from tools import clarify_gateway as _reg
+            if self.session_id:
+                _reg.set_autonomy_wait_seconds(
+                    self.session_id,
+                    policy.wait_timeout() if policy.delegated else None,
+                    irreversible_ok=policy.irreversible_ok,
+                )
+        except Exception:  # pragma: no cover - a broken registry must not kill a turn
+            pass
+
