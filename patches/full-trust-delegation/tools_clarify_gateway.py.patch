+# Per-session full-trust delegation ("一次做完") wait window, in seconds. Set when a delegated turn
+# starts, cleared when it ends. ``0`` means "do not block: self-decide and continue"; a missing
+# session means "supervised: use the global clarify_timeout". Kept beside the clarify entries on
+# purpose — this is exactly the state "may this prompt block the gateway?" needs, and a surface
+# that already has the session_key can consult it without the agent object.
+_autonomy_wait: Dict[str, float] = {}
+# Per-session counterpart: whether that delegated turn was allowed to run irreversible commands
+# (agent.autonomy.irreversible_ok). Absent means "locked: irreversible still escalates".
+_autonomy_irreversible: Dict[str, bool] = {}
+
 # Outcomes for typed clarify replies. Gateway cancels the pending prompt on
