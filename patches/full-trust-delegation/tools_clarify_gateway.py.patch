         return any(_entries.get(cid) is not None for cid in _session_index.get(session_key) or [])
 
 
+def set_autonomy_wait_seconds(session_key: str, seconds: Optional[float],
+                              irreversible_ok: bool = False) -> None:
+    """Record (``seconds``) or clear (``None``) the delegation state for a session.
+
+    Called when a full-trust delegated turn starts and when it ends. A negative value is
+    clamped to ``0`` so a misconfigured ``autonomy_wait_seconds`` degrades to
+    "self-decide immediately" rather than to an unbounded block. ``irreversible_ok`` is stored
+    alongside so the approval wait can keep escalating the handful of destructive commands
+    unless the user explicitly opted in.
+    """
+    with _lock:
+        if seconds is None:
+            _autonomy_wait.pop(session_key, None)
+            _autonomy_irreversible.pop(session_key, None)
+            return
+        try:
+            wait = float(seconds)
+        except (TypeError, ValueError):
+            _autonomy_wait.pop(session_key, None)
+            _autonomy_irreversible.pop(session_key, None)
+            return
+        _autonomy_wait[session_key] = max(0.0, wait)
+        _autonomy_irreversible[session_key] = bool(irreversible_ok)
+
+
+def get_autonomy_wait_seconds(session_key: str) -> Optional[float]:
+    """The delegation wait window for a session, or ``None`` when it is supervised.
+
+    ``None`` is the important answer: it tells every surface to fall back to the global
+    ``clarify_timeout`` and behave exactly as it did before delegation existed. ``0`` is the
+    other distinct answer: the turn is delegated and must not block.
+    """
+    with _lock:
+        return _autonomy_wait.get(session_key)
+
+
+def is_delegated(session_key: str) -> bool:
+    """True while a session is running a full-trust delegated turn."""
+    with _lock:
+        return session_key in _autonomy_wait
+
+
+def is_irreversible_ok(session_key: str) -> bool:
+    """Whether this delegated turn was configured to run irreversible commands.
+
+    A missing session answers ``False`` (locked) on purpose: the question is only ever asked
+    for sessions already known to be delegated, so "I don't know" must resolve to "ask".
+    """
+    with _lock:
+        return bool(_autonomy_irreversible.get(session_key, False))
+
+
