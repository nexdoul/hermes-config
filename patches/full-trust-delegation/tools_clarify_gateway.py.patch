     blocked agent threads don't outlive it; returns how many were cancelled. Cancelled waiters
@@ -253,6 +315,10 @@ def clear_session(session_key: str) -> int:
             entry.response = ""
             entry.event.set()
             cancelled += 1
+        # A cleared session is supervised again: leaving the delegation window behind would
+        # silently run the NEXT turn without supervision after a /new.
+        _autonomy_wait.pop(session_key, None)
+        _autonomy_irreversible.pop(session_key, None)
     return cancelled
 
 
