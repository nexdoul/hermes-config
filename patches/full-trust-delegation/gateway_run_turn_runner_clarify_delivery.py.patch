 SEND_ACK_WINDOW = 15
 
+# Returned instead of the canonical timeout text when a full-trust delegated turn (agent.autonomy)
+# declined to wait. Deliberately the SAME wording the timeout path already produces: the agent's
+# contract for "no answer arrived" is unchanged, so no surface needs to learn a new sentinel and
+# the model's own "use your best judgement to make the choice and proceed" handling still fires.
+DELEGATED_NO_ANSWER = (
+    "The user did not provide a response within the time limit. "
+    "Use your best judgement to make the choice and proceed."
+)
+
+# Fallback when the active policy cannot be resolved: behave exactly like a supervised turn.
+_GLOBAL_CLARIFY_TIMEOUT = 3600
+
+
+def _clarify_wait_timeout(*, session_key: str, fallback: Any = None) -> float | None:
+    """How long this clarify may block: the global ``clarify_timeout``, or the delegating turn's
+    shorter autonomy window.
+
+    ``None`` means "wait for the global timeout" (the normal supervised path, untouched) — and in
+    that case ``fallback`` (the caller's own ``get_clarify_timeout()`` value) is returned so every
+    surface keeps reading the timeout from exactly the place it always did. A value of ``0`` means
+    the turn is delegated and must not block at all. The per-turn policy lives in the clarify
+    gateway's registry (set by the turn runner when the turn starts), so this works from any
+    thread without reaching into the agent object.
+    """
+    from tools import clarify_gateway as clarify_mod
+    getter = getattr(clarify_mod, "get_autonomy_wait_seconds", None)
+    if callable(getter):
+        try:
+            seconds = getter(session_key)
+        except Exception:  # pragma: no cover - registry must never break a prompt
+            seconds = None
+        if seconds is not None:
+            try:
+                return max(0.0, float(seconds))
+            except (TypeError, ValueError):
+                pass
+    return fallback
+
 
