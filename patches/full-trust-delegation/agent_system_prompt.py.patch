+def _autonomy_guidance_block(agent: Any) -> str | None:
+    """The full-trust delegation block for a delegated turn, or ``None`` for a supervised one.
+
+    Reads the policy the turn runner attached to the agent (``agent._autonomy_policy``), so the
+    prompt follows the same decision the runtime already enforces: no policy, ``delegated=False``,
+    or a delegated turn whose irreversible_ok is off all yield ``None``, and a supervised session's
+    system prompt stays byte-identical to the pre-delegation build.
+    """
+    policy = getattr(agent, "_autonomy_policy", None)
+    if policy is None or not getattr(policy, "delegated", False):
+        return None
+    return AUTONOMY_GUIDANCE
+
