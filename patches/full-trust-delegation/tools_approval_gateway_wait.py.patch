+from agent.autonomy_policy import is_irreversible, may_run_delegated_command  # noqa: F401
 
 logger = logging.getLogger("tools.approval")
 
 
+def _notify_danger_to_main(session_key, approval_data) -> None:
+    """Tell the ONE watched session that a dangerous command needs a human decision.
+
+    An irreversible command keeps escalating even under full-trust delegation, which means a
+    card is waiting for a click in a window the user has muted. Without this the command sits
+    there forever and the turn behind it stalls silently.
+
+    Runs on the agent thread, so it must never block: publication is queued onto the gateway
+    loop when one is reachable and dropped otherwise. The reminder is a courtesy, the card in
+    the originating session is the real interaction.
+    """
+    try:
+        command = str((approval_data or {}).get("command") or "")
+        if not command:
+            return
+        event = {
+            "kind": "danger",
+            "session_key": session_key or "",
+            "summary": "托管任务遇到不可逆操作，已暂停等你确认。",
+            "detail": f"`{command.strip()[:160]}`",
+        }
+        try:
+            from gateway.run_main_notifier import publish_external
+            publish_external(event)
+        except Exception:  # pragma: no cover - a missed reminder must not block a turn
+            logger.debug("danger notification to main session failed", exc_info=True)
+    except Exception:  # pragma: no cover
+        logger.debug("danger notification build failed", exc_info=True)
+
+
 class _ApprovalEntry:
