+    # Full-trust delegation ("一次做完"): a delegated turn answers its own approvals instead of
+    # parking the gateway on a card nobody is reading. The command must be reversible — an
+    # irreversible one keeps escalating even in `always` mode, because delegation is a bet on
+    # checkpoints/revert, not a licence to destroy data. Runs after the pre-hook (observers see
+    # the lifecycle) and before notify_cb (so no card is ever sent), and drops the queued entry
+    # exactly as any resolved prompt would.
+    if may_run_delegated_command(session_key, approval_data.get("command", "")):
+        logger.info(
+            "Autonomy auto-approving session %s command (delegated turn): %.60s",
+            session_key, approval_data.get("command", ""),
+        )
+        _drop_entry("set")
+        return {"resolved": True, "choice": "once", "reason": "autonomy auto-approval",
+                "autonomy": True}
+
