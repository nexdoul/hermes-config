+"""A delegated turn must APPROVE its own prompts instead of parking the gateway on a card.
+
+The blocking approval wait (``tools/approval_gateway_wait._await_gateway_decision``) is where a
+dangerous command either runs or waits for a human. Under "一次做完" the user has stopped reading
+chat, so a card nobody answers would stall the whole run for ``approvals.timeout`` and then deny
+the command anyway — the worst of both outcomes.
+
+Contract under test:
+* a supervised session is byte-identical to before (notify_cb called, real wait);
+* a delegated session auto-approves a REVERSIBLE command and never calls notify_cb (no card);
+* an IRREVERSIBLE command still escalates even when delegated, unless ``irreversible_ok``;
+* a broken delegation registry fails CLOSED (asks the human), never silently allows.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from tools import approval as approval_mod
+from tools import clarify_gateway as clarify_mod
+from tools.approval_gateway_wait import _await_gateway_decision
+
+SESSION = "test-approval-autonomy"
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry(monkeypatch):
+    clarify_mod.set_autonomy_wait_seconds(SESSION, None)
+    # A supervised prompt really blocks on approvals.timeout (300s by default); that is the
+    # behaviour this file asserts is unchanged, so give it a 1s clock instead of the real one.
+    monkeypatch.setattr(
+        "tools.approval_context._get_approval_timeout", lambda: 1, raising=False
+    )
+    yield
+    clarify_mod.set_autonomy_wait_seconds(SESSION, None)
+    with approval_mod._lock:
+        approval_mod._gateway_queues.pop(SESSION, None)
+
+
+def _decision(session_key: str, command: str, *, notify: MagicMock) -> dict:
+    return _await_gateway_decision(
+        session_key,
+        notify,
+        {
+            "command": command,
+            "pattern_key": "rm",
+            "pattern_keys": ["rm"],
+            "description": "dangerous command",
+        },
+        surface="gateway",
+    )
+
+
+# ── supervised: unchanged behaviour ─────────────────────────────────────────────────────────
+
+def test_supervised_session_still_notifies_and_waits():
+    """The pre-delegation code path must be untouched when the user never asked for delegation."""
+    notify = MagicMock()
+    decision = _decision(SESSION, "rm -rf /home/hatch/workspace/tmp", notify=notify)
+    notify.assert_called_once()
+    # Nobody answered, so the wait ended unresolved — exactly the old behaviour.
+    assert decision["resolved"] is False
+    assert decision.get("autonomy") is None
+
+
+# ── delegated: self-approval ───────────────────────────────────────────────────────────────
+
+def test_delegated_session_auto_approves_reversible_command_without_a_card():
+    notify = MagicMock()
+    clarify_mod.set_autonomy_wait_seconds(SESSION, 300)
+    decision = _decision(SESSION, "rm -rf /home/hatch/workspace/tmp", notify=notify)
+    notify.assert_not_called()
+    assert decision == {
+        "resolved": True,
+        "choice": "once",
+        "reason": "autonomy auto-approval",
+        "autonomy": True,
+    }
+    # The pending queue must not retain an entry the agent already answered.
+    with approval_mod._lock:
+        assert approval_mod._gateway_queues.get(SESSION) in (None, [])
+
+
+def test_delegated_session_leaves_no_queued_approval_behind():
+    notify = MagicMock()
+    clarify_mod.set_autonomy_wait_seconds(SESSION, 0)
+    _decision(SESSION, "ls -la", notify=notify)
+    with approval_mod._lock:
+        assert SESSION not in approval_mod._gateway_queues
+
+
+# ── delegated but irreversible: still escalates ────────────────────────────────────────────
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "rm -rf /home",
+        "rm -rf /",
+        "git push --force origin main",
+        "drop database prod",
+    ],
+)
+def test_delegated_session_still_asks_about_irreversible_commands(command):
+    notify = MagicMock()
+    clarify_mod.set_autonomy_wait_seconds(SESSION, 0)  # even in "do not wait" mode
+    decision = _decision(SESSION, command, notify=notify)
+    notify.assert_called_once(), (
+        f"an irreversible command ran unattended under delegation: {command!r} — delegation is "
+        "a bet on reversibility, not a licence to destroy data"
+    )
+    assert decision.get("autonomy") is None
+
+
+def test_irreversible_ok_is_honoured_when_explicitly_enabled():
+    notify = MagicMock()
+    clarify_mod.set_autonomy_wait_seconds(SESSION, 0, irreversible_ok=True)
+    decision = _decision(SESSION, "rm -rf /home", notify=notify)
+    notify.assert_not_called()
+    assert decision["choice"] == "once"
+
+
+# ── failure modes ──────────────────────────────────────────────────────────────────────────
+
+def test_broken_registry_fails_closed():
+    """A delegation check that cannot be evaluated must ask the human, never allow unattended."""
+    notify = MagicMock()
+    original = clarify_mod.is_delegated
+    clarify_mod.is_delegated = lambda session_key: (_ for _ in ()).throw(RuntimeError("down"))
+    try:
+        decision = _decision(SESSION, "ls -la", notify=notify)
+        notify.assert_called_once()
+        assert decision["resolved"] is False
+    finally:
+        clarify_mod.is_delegated = original
