+"""Full-trust delegation ("一次做完"): a delegated turn must not park on a human.
+
+The user says "一次做完" / "做完之后叫我" and stops reading chat. Three things must then hold, and
+each has a test here:
+
+1. **Trigger detection** — the phrase arms delegation for exactly that turn, and an ordinary
+   message does not (a phrase match must never be loose enough to fire on "帮我改一下").
+2. **No unbounded block** — the default ``clarify_timeout`` is an hour. A delegated turn must use
+   its own window instead, and ``mode: always`` must not block at all: it registers the prompt,
+   declines to wait, and hands the agent the canonical "use your best judgement" text so the
+   model's existing self-decision path fires unchanged.
+3. **Irreversibility still escalates** — ``force-push`` / ``rm -rf /home`` / ``DROP DATABASE`` keep
+   requiring a human unless ``irreversible_ok`` is set, even in ``always`` mode. Delegation is a
+   bet on reversibility (see ``checkpoints.enabled``), not a licence to destroy data.
+
+Non-delegated turns must be byte-identical in behaviour to before: that is asserted too.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent.autonomy_policy import (
+    DEFAULT_WAIT_SECONDS,
+    AutonomyPolicy,
+    has_trigger,
+    is_irreversible,
+    resolve,
+)
+from tools import clarify_gateway as clarify_mod
+from tools.clarify_tool import TIMEOUT_RESPONSE
+from gateway.run_turn_runner_clarify_delivery import (
+    DELEGATED_NO_ANSWER,
+    _clarify_wait_timeout,
+)
+
+SESSION = "test-autonomy-session"
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry():
+    """The autonomy window is module-level state; every test starts and ends supervised."""
+    clarify_mod.set_autonomy_wait_seconds(SESSION, None)
+    yield
+    clarify_mod.set_autonomy_wait_seconds(SESSION, None)
+
+
+# ── 1. trigger detection ───────────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        "一次做完",
+        "这个需求你一次做完再叫我",
+        "一次做到底",
+        "一口气做完吧",
+        "做完之后叫我",
+        "做完再叫我",
+        "全程托管",
+        "完全托管，别看了",
+        "不用再问我，你自己定",
+        "别再问我了",
+        "后续步骤你自行决定",
+    ],
+)
+def test_trigger_phrase_arms_delegation(message):
+    assert has_trigger(message) is True, (
+        f"a full-trust phrase went unrecognised: {message!r} — the feature is unreachable "
+        "if the trigger does not fire"
+    )
+    policy = resolve(message, session_mode="off")
+    assert policy.delegated is True
+    assert policy.reason
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        "帮我修一下这个 bug",
+        "新建一个文件",
+        "重启一下 hermes",
+        "这次先做第一步",
+        "",
+        None,
+        "完成之后告诉我结果",  # asks for a report, not for unsupervised continuation
+    ],
+)
+def test_ordinary_message_stays_supervised(message):
+    assert has_trigger(message) is False, (
+        f"an ordinary message armed unsupervised execution: {message!r}"
+    )
+    policy = resolve(message, session_mode="off")
+    assert policy.delegated is False
+    assert policy.wait_timeout() is None
+    assert policy.sends_prompt is True
+
+
+def test_trigger_beats_configured_mode_off():
+    """`mode: off` is the default, but an explicit phrase still delegates that one turn."""
+    policy = resolve("一次做完", session_mode="off")
+    assert policy.delegated is True
+    assert policy.reason == "delegated by trigger phrase (one-shot)"
+
+
+# ── 2. wait windows ────────────────────────────────────────────────────────────────────────
+
+def test_supervised_wait_is_none_so_behaviour_is_unchanged():
+    policy = resolve("帮我看一下", session_mode="off")
+    assert policy.wait_timeout() is None
+    clarify_mod.set_autonomy_wait_seconds(SESSION, None)
+    assert _clarify_wait_timeout(session_key=SESSION) is None, (
+        "an unsupervised registry entry leaked into a supervised session — every prompt would "
+        "use the autonomy window instead of the global clarify_timeout"
+    )
+
+
+def test_auto_mode_waits_its_own_window_not_the_global_hour():
+    """The default clarify_timeout is 3600s; delegation must not inherit it."""
+    policy = resolve("一次做完", session_mode="auto", wait_seconds=DEFAULT_WAIT_SECONDS)
+    clarify_mod.set_autonomy_wait_seconds(SESSION, policy.wait_timeout())
+    assert _clarify_wait_timeout(session_key=SESSION) == float(DEFAULT_WAIT_SECONDS)
+    assert float(DEFAULT_WAIT_SECONDS) < 3600
+
+
+def test_always_mode_does_not_block_at_all():
+    policy = resolve("一次做完", session_mode="always")
+    assert policy.sends_prompt is False, (
+        "mode: always still rendered the prompt — the point of always is that the agent does "
+        "not ask, it decides"
+    )
+    assert policy.wait_timeout() == 0.0
+    clarify_mod.set_autonomy_wait_seconds(SESSION, policy.wait_timeout())
+    timeout = _clarify_wait_timeout(session_key=SESSION)
+    assert timeout == 0.0
+
+
+def test_delegated_sentinel_matches_canonical_timeout_text():
+    """The agent's contract for "no answer arrived" must not change, or no surface handles it."""
+    assert DELEGATED_NO_ANSWER == TIMEOUT_RESPONSE
+
+
+def test_broken_registry_degrades_to_supervised_not_a_crash():
+    original = clarify_mod.get_autonomy_wait_seconds
+    clarify_mod.get_autonomy_wait_seconds = lambda session_key: (_ for _ in ()).throw(
+        RuntimeError("registry unavailable")
+    )
+    try:
+        assert _clarify_wait_timeout(session_key=SESSION) is None
+    finally:
+        clarify_mod.get_autonomy_wait_seconds = original
+
+
+# ── 3. registry lifecycle ──────────────────────────────────────────────────────────────────
+
+def test_clear_session_releases_delegation():
+    """`/new` must return the session to supervision, or the NEXT turn runs unattended."""
+    clarify_mod.register(clarify_id="c1", session_key=SESSION, question="q?", choices=["a", "b"])
+    clarify_mod.set_autonomy_wait_seconds(SESSION, 300)
+    assert clarify_mod.is_delegated(SESSION) is True
+    clarify_mod.clear_session(SESSION)
+    assert clarify_mod.is_delegated(SESSION) is False
+    assert clarify_mod.get_autonomy_wait_seconds(SESSION) is None
+
+
+def test_negative_wait_clamps_to_zero_not_unbounded():
+    clarify_mod.set_autonomy_wait_seconds(SESSION, -5)
+    assert clarify_mod.get_autonomy_wait_seconds(SESSION) == 0.0
+
+
+def test_non_numeric_wait_clears_the_entry():
+    clarify_mod.set_autonomy_wait_seconds(SESSION, 300)
+    # deliberately wrong type: a bad value must clear the entry, never block forever
+    clarify_mod.set_autonomy_wait_seconds(SESSION, "not-a-number")  # type: ignore[arg-type]
+    assert clarify_mod.get_autonomy_wait_seconds(SESSION) is None
+
+
+def test_sessions_are_isolated():
+    clarify_mod.set_autonomy_wait_seconds("sess-A", 120)
+    try:
+        assert clarify_mod.get_autonomy_wait_seconds("sess-A") == 120.0
+        assert clarify_mod.get_autonomy_wait_seconds("sess-B") is None
+    finally:
+        clarify_mod.set_autonomy_wait_seconds("sess-A", None)
+
+
+# ── 4. irreversibility guard ───────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "git push --force origin main",
+        "git push -f",
+        "git reset --hard HEAD~1",
+        "git clean -fd",
+        "rm -rf /",
+        "rm -rf //",
+        "rm -rf /home",
+        "rm -rf //etc",
+        "rm -fr /usr",
+        "drop table users",
+        "DROP DATABASE prod",
+        "Truncate Table logs",
+        "mkfs.ext4 /dev/sda1",
+        "dd if=/dev/zero of=/dev/sda",
+    ],
+)
+def test_irreversible_shapes_are_recognised(command):
+    assert is_irreversible(command) is True, f"missed an irreversible shape: {command!r}"
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "git push origin main",
+        "git push origin --force-with-lease",  # the safe force
+        "git reset --soft HEAD~1",
+        "rm -f build.log",
+        "rm -rf node_modules",  # nested path = ordinary cleanup
+        "rm -rf /home/hatch/workspace/tmp",  # nested, not a top-level root
+        "ls -la",
+        "python3 build.py",
+    ],
+)
+def test_reversible_commands_are_not_flagged(command):
+    assert is_irreversible(command) is False, (
+        f"an ordinary command was treated as irreversible, which would escalate harmless "
+        f"steps and defeat the delegation: {command!r}"
+    )
+
+
+def test_delegated_turn_still_blocks_irreversible_commands():
+    policy = resolve("一次做完", session_mode="always")
+    assert policy.irreversible_ok is False
+    assert policy.may_run_command("ls -la") is True
+    assert policy.may_run_command("rm -rf /home") is False
+
+
+def test_irreversible_ok_is_an_explicit_opt_in():
+    policy = resolve("一次做完", session_mode="always", irreversible_ok=True)
+    assert policy.may_run_command("rm -rf /home") is True
+
+
+def test_supervised_turns_never_consult_the_guard():
+    policy = resolve("帮我看一下", session_mode="off")
+    assert policy.may_run_command("rm -rf /home") is True  # normal approvals handle it
+
+
+# ── 5. malformed config degrades instead of arming silently ────────────────────────────────
+
+@pytest.mark.parametrize(
+    "mode",
+    ["", "off", "OFF", "sometimes", "enabled", None, "always-with-typo"],
+)
+def test_unknown_mode_falls_back_to_supervised(mode):
+    policy = resolve("帮我看一下", session_mode=mode)  # no trigger phrase
+    assert policy.delegated is False
+    assert policy.wait_timeout() is None
+
+
+@pytest.mark.parametrize("wait", [None, "abc", -1, float("nan")])
+def test_malformed_wait_seconds_use_the_default(wait):
+    policy = resolve("一次做完", session_mode="auto", wait_seconds=wait)
+    assert policy.delegated is True
+    assert policy.wait_timeout() == float(DEFAULT_WAIT_SECONDS)
+
+
+def test_policy_without_trigger_and_unknown_mode_is_identical_to_supervised():
+    a = resolve("帮我看一下", session_mode="garbage")
+    b = resolve("帮我看一下", session_mode="off")
+    assert (a.delegated, a.wait_timeout(), a.sends_prompt) == (
+        b.delegated, b.wait_timeout(), b.sends_prompt
+    )
+
+
+# ── 6. system-prompt injection (step 3: let the model choose the order itself) ──────────────
+
+def test_supervised_session_gets_no_autonomy_block():
+    """A supervised session's system prompt must be byte-identical to the pre-feature build."""
+    from agent.system_prompt import _autonomy_guidance_block
+
+    class _Agent:
+        def __init__(self, policy=None):
+            self._autonomy_policy = policy
+
+    assert _autonomy_guidance_block(_Agent(None)) is None
+    assert _autonomy_guidance_block(_Agent(resolve("帮我修一下", session_mode="off"))) is None
+
+
+def test_delegated_turn_gets_the_autonomy_block():
+    from agent.prompt_builder import AUTONOMY_GUIDANCE
+    from agent.system_prompt import _autonomy_guidance_block
+
+    class _Agent:
+        def __init__(self, policy):
+            self._autonomy_policy = policy
+
+    block = _autonomy_guidance_block(_Agent(resolve("一次做完", session_mode="off")))
+    assert block == AUTONOMY_GUIDANCE
+
+
+def test_autonomy_block_carries_the_three_load_bearing_instructions():
+    from agent.prompt_builder import AUTONOMY_GUIDANCE
+
+    # choose an order yourself, act without parking on a question, keep it revertible
+    assert "choose an order yourself" in AUTONOMY_GUIDANCE
+    assert "Do not park on a question" in AUTONOMY_GUIDANCE
+    assert "irreversible" in AUTONOMY_GUIDANCE and "/rollback" in AUTONOMY_GUIDANCE
+
+
+def test_agent_without_the_attribute_does_not_break_the_prompt():
+    """A cached agent built before this feature must still assemble a system prompt."""
+    from agent.system_prompt import _autonomy_guidance_block
+
+    class _BareAgent:
+        pass
+
+    assert _autonomy_guidance_block(_BareAgent()) is None
