@@ -602,7 +618,12 @@ class CLIModalMixin:
             return self._clarify_callback_batch(questions)
 
         # Canonical clarify timeout, shared with the gateway/TUI path; `<= 0` = unlimited.
+        # A full-trust delegated turn ("一次做完") shortens it to the turn's own window — and
+        # `always` mode to zero, so the panel never opens at all and the agent self-decides.
         timeout = resolve_clarify_timeout(CLI_CONFIG)
