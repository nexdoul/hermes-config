+    def _autonomy_wait_seconds(self):
+        """This session's delegation wait window, or ``None`` when it is supervised.
+
+        Shared registry means the CLI, the gateway and any future surface make the same decision
+        for the same turn. A broken registry answers ``None`` (behave exactly as before) rather
+        than guessing, so a failure here can never shorten or lengthen a real prompt by accident.
+        """
+        try:
+            from tools import clarify_gateway as _reg
+            session_key = getattr(self, "session_id", None)
+            if not session_key:
+                return None
+            return _reg.get_autonomy_wait_seconds(session_key)
+        except Exception:  # pragma: no cover - a broken registry must not change a prompt
+            return None
+
     def _clarify_callback(self, question, choices, multi_select=False, questions=None):
