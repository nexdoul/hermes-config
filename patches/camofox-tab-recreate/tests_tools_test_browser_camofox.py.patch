 class TestCamofoxNavigate:
+    def test_recreates_tab_on_410_after_server_restart(self, monkeypatch):
+        """A stale UUID yields 410 from Camofox after restart, not 404."""
+        import requests
+        from tools import browser_camofox as mod
+        monkeypatch.setenv("CAMOFOX_URL", "http://localhost:9377")
+        session = {"user_id": "hermes-browser-user", "session_key": "browser-main", "tab_id": "stale-uuid"}
+        monkeypatch.setattr(mod, "_get_session", lambda task_id: session)
+        gone = requests.Response()
+        gone.status_code = 410
+        gone.url = "http://localhost:9377/tabs/stale-uuid/navigate"
+        def fake_post(path, body, timeout=None):
+            raise requests.HTTPError("410 Gone", response=gone)
+        monkeypatch.setattr(mod, "_post", fake_post)
+        def fake_ensure(task_id, url):
+            assert session["tab_id"] is None
+            session["tab_id"] = "new-uuid"
+            return session
+        monkeypatch.setattr(mod, "_ensure_tab", fake_ensure)
+        restored, data = mod._navigate_tab("task-after-restart", "https://example.com")
+        assert restored["tab_id"] == "new-uuid"
+        assert data["url"] == "https://example.com"
+
     @patch("tools.browser_camofox.requests.post")
