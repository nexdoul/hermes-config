+    def _exec_approval_actions(
+            self, *, allow_permanent: bool, allow_session: bool, smart_denied: bool
+    ) -> List[Tuple[str, str, str]]:
+        """Button rows with the emoji prefix kept and only the word localized.
+
+        Feishu labels are shorter than the base English ones ("✅ Session" vs
+        "Allow Session"), so they cannot be swapped by phrase replacement. The
+        adapter's own English wording is kept for ``en``; anything else reads the
+        word from the catalog. The choice→action mapping is untouched, which is
+        what the click handler relies on.
+        """
+        from agent.i18n import get_language
+        from gateway.platforms.base_exec_approval import ea_action_label
+        choices = ["once"]
+        if not smart_denied and allow_session:
+            choices.append("session")
+            if allow_permanent:
+                choices.append("always")
+        choices.append("deny")
+        rows = []
+        for choice in choices:
+            label = self._EA_ACTION_LABELS[choice]
+            if get_language() != "en":
+                emoji, _, _rest = label.partition(" ")
+                label = f"{emoji} {ea_action_label(choice)}"
+            rows.append((label, choice, self._EA_ACTION_STYLES.get(choice, "")))
+        return rows
+
